# CATATAN: jangan taruh komentar di belakang nilai (terutama nilai kosong) —
# pembaca .env menganggapnya bagian dari nilai. Tulis komentar di baris sendiri.

# local | staging | production
APP_ENV=local
PORT=8080
# dipakai untuk link verifikasi QR
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TZ_APP=Asia/Jakarta

DATABASE_URL=postgres://postgres:GANTI_PASSWORD@localhost:5432/project_inventory?sslmode=disable
# Supabase: session pooler 5432 / direct. Kosong = pakai DATABASE_URL
MIGRATE_DATABASE_URL=
# session | transaction (Supabase 6543 -> matikan prepared statement)
DB_POOLER_MODE=session
DB_MAX_CONNS=10
# Hanya untuk `make test-integration` (tes memakai schema sementara, tabel asli tidak disentuh).
# Boleh sama dengan DATABASE_URL lokal. Kosong = tes integrasi di-skip.
TEST_DATABASE_URL=

JWT_ACCESS_SECRET=ganti-dengan-random-64-char
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=336h
# cookie | body
AUTH_REFRESH_MODE=cookie
COOKIE_SECURE=false

GOTENBERG_URL=http://localhost:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Supabase: https://<ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=erp-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# header Authorization untuk /internal/jobs/*
CRON_SECRET=ganti-random
SEED_ADMIN_EMAIL=admin@contoh.id
# wajib diisi (min. 8 karakter) sebelum `make seed`; admin wajib ganti saat login pertama
SEED_ADMIN_PASSWORD=
