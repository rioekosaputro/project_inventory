{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.go"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/jobs/billing",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/v1/internal/jobs/daily",
      "schedule": "30 18 * * *"
    }
  ],
  "build": {
    "env": {
      "GO_BUILD_FLAGS": "-ldflags '-s -w'"
    }
  }
}
