# Prefix API. Biarkan /api/v1: dev server mem-proxy /api ke backend, jadi satu origin
# (cookie refresh HttpOnly berfungsi sama seperti di staging/production).
VITE_API_BASE_URL=/api/v1

# Target proxy dev server (hanya untuk `npm run dev`). Default http://localhost:8080
# VITE_DEV_API_TARGET=http://localhost:8080

# Peta (dipakai mulai Fase 3)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_DEFAULT_CENTER=-6.9825,110.4091
